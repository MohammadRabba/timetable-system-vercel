generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schools   School[]
  users     User[]
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           UserRole      @default(VIEWER)
  organizationId String?
  schoolId       String?
  teacherId      String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auditLogs      AuditLog[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  school         School?       @relation(fields: [schoolId], references: [id])
  teacher        Teacher?      @relation(fields: [teacherId], references: [id])
}

model School {
  id                String             @id @default(cuid())
  organizationId    String
  name              String
  principalName     String?
  logoUrl           String?
  address           String?
  phone             String?
  email             String?
  currentYearId     String?
  currentSemester   String?
  workingDays       String
  periodsPerDay     Int                @default(7)
  periodDuration    Int                @default(45)
  breakDuration     Int                @default(15)
  startTime         String             @default("07:30")
  endTime           String             @default("14:00")
  rtl               Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  academicYears     AcademicYear[]
  auditLogs         AuditLog[]
  branches          Branch[]
  constraints       Constraint[]
  duties            Duty[]
  grades            Grade[]
  lessons           Lesson[]
  periods           Period[]
  rooms             Room[]
  schedulingRuns    SchedulingRun[]
  currentYear       AcademicYear?      @relation("CurrentYearOfSchool", fields: [currentYearId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections          Section[]
  students          Student[]
  subjects          Subject[]
  teachers          Teacher[]
  timetableVersions TimetableVersion[]
  users             User[]
}

model AcademicYear {
  id           String    @id @default(cuid())
  schoolId     String
  name         String
  startDate    DateTime
  endDate      DateTime
  semesters    String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  periods      Period[]
  isCurrentFor School[]  @relation("CurrentYearOfSchool")
  sections     Section[] @relation("SectionsByYear")
}

model Period {
  id        String       @id @default(cuid())
  schoolId  String
  yearId    String
  order     Int
  label     String
  startTime String
  endTime   String
  type      String       @default("TEACHING")
  isBreak   Boolean      @default(false)
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year      AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model Grade {
  id        String    @id @default(cuid())
  schoolId  String
  stage     String
  name      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branches  Branch[]
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections  Section[]
}

model Branch {
  id        String    @id @default(cuid())
  schoolId  String
  gradeId   String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  grade     Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections  Section[]

  @@unique([schoolId, name])
}

model Section {
  id               String           @id @default(cuid())
  schoolId         String
  yearId           String?
  gradeId          String
  branchId         String?
  name             String
  code             String
  studentCount     Int              @default(0)
  roomId           String?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lessons          Lesson[]
  branch           Branch?          @relation(fields: [branchId], references: [id])
  grade            Grade            @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  room             Room?            @relation(fields: [roomId], references: [id])
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year             AcademicYear?    @relation("SectionsByYear", fields: [yearId], references: [id])
  students         Student[]
  teacherSections  TeacherSection[]
  timetableEntries TimetableEntry[]
}

model Student {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  name      String
  studentNo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Subject {
  id                  String           @id @default(cuid())
  schoolId            String
  name                String
  code                String
  type                String           @default("THEORY")
  defaultWeekly       Int              @default(0)
  maxPerDay           Int              @default(2)
  minGap              Int              @default(0)
  consecutive         Boolean          @default(false)
  requiredConsecutive Int              @default(0)
  preferredPeriods    String
  forbiddenPeriods    String
  requiredRoomType    String?
  requiredEquipment   String?
  priority            Int              @default(100)
  color               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  lessons             Lesson[]
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects     TeacherSubject[]
  timetableEntries    TimetableEntry[]
}

model Teacher {
  id               String                @id @default(cuid())
  schoolId         String
  name             String
  employeeNumber   String
  specialization   String?
  email            String?
  phone            String?
  status           String                @default("ACTIVE")
  requiredWorkload Int                   @default(24)
  maxDailyPeriods  Int                   @default(7)
  minDailyPeriods  Int                   @default(0)
  requiredSeventh  Int                   @default(0)
  maxSeventh       Int                   @default(3)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  duties           Duty[]
  lessons          Lesson[]
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  availability     TeacherAvailability[]
  daysOff          TeacherDayOff[]
  preferences      TeacherPreference[]
  sections         TeacherSection[]
  subjects         TeacherSubject[]
  timetableEntries TimetableEntry[]
  user             User?
}

model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  subjectId String
  priority  Int     @default(0)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model TeacherSection {
  id        String  @id @default(cuid())
  teacherId String
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId])
}

model TeacherAvailability {
  id        String            @id @default(cuid())
  teacherId String
  day       String
  period    Int
  state     AvailabilityState @default(AVAILABLE)
  teacher   Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, day, period])
}

model TeacherDayOff {
  id        String  @id @default(cuid())
  teacherId String
  day       String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, day])
}

model TeacherPreference {
  id        String  @id @default(cuid())
  teacherId String
  day       String
  period    Int
  type      String  @default("PREFERRED")
  weight    Int     @default(100)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Room {
  id                 String           @id @default(cuid())
  schoolId           String
  name               String
  code               String
  type               String           @default("CLASSROOM")
  capacity           Int              @default(30)
  equipment          String?
  availablePeriods   String?
  unavailablePeriods String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  lessons            Lesson[]
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections           Section[]
  timetableEntries   TimetableEntry[]
}

model Lesson {
  id                  String           @id @default(cuid())
  schoolId            String
  yearId              String?
  teacherId           String
  subjectId           String
  sectionId           String
  roomId              String?
  weeklyOccurrences   Int              @default(1)
  duration            Int              @default(1)
  lessonType          String           @default("THEORY")
  priority            Int              @default(100)
  requiredConsecutive Int              @default(0)
  preferredSlots      String?
  forbiddenSlots      String?
  fixed               Boolean          @default(false)
  fixedDay            String?
  fixedPeriod         Int?
  locked              Boolean          @default(false)
  coTeacherId         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  room                Room?            @relation(fields: [roomId], references: [id])
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section             Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject             Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher             Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year                AcademicYear?    @relation(fields: [yearId], references: [id])
  timetableEntries    TimetableEntry[]
}

model Duty {
  id               String           @id @default(cuid())
  schoolId         String
  teacherId        String
  type             String           @default("DUTY")
  title            String
  day              String
  period           Int
  location         String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher          Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
}

model Constraint {
  id        String   @id @default(cuid())
  schoolId  String
  code      String
  name      String
  type      String   @default("HARD")
  weight    Int      @default(1000000)
  enabled   Boolean  @default(true)
  params    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model TimetableVersion {
  id             String            @id @default(cuid())
  schoolId       String
  version        Int
  name           String
  reason         String?
  createdBy      String
  statistics     String?
  snapshot       String?
  isCurrent      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  schedulingRuns SchedulingRun[]
  changeHistory  TimetableChange[]
  entries        TimetableEntry[]
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model TimetableEntry {
  id        String           @id @default(cuid())
  schoolId  String
  versionId String
  lessonId  String?
  dutyId    String?
  teacherId String?
  sectionId String?
  subjectId String?
  roomId    String?
  day       String
  period    Int
  cellType  String           @default("TEACHING")
  locked    Boolean          @default(false)
  duty      Duty?            @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  lesson    Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  room      Room?            @relation(fields: [roomId], references: [id])
  section   Section?         @relation(fields: [sectionId], references: [id])
  subject   Subject?         @relation(fields: [subjectId], references: [id])
  teacher   Teacher?         @relation(fields: [teacherId], references: [id])
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, day, period, teacherId])
}

model TimetableChange {
  id        String           @id @default(cuid())
  versionId String
  action    String
  payload   String
  undone    Boolean          @default(false)
  createdAt DateTime         @default(now())
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model SchedulingRun {
  id           String            @id @default(cuid())
  schoolId     String
  status       String            @default("QUEUED")
  progress     Int               @default(0)
  solverStatus String?
  mode         String            @default("BALANCED")
  timeLimitSec Int               @default(60)
  result       String?
  error        String?
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?
  versionId    String?
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version      TimetableVersion? @relation(fields: [versionId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  schoolId  String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  ip        String?
  createdAt DateTime @default(now())
  school    School?  @relation(fields: [schoolId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  SCHEDULER
  TEACHER
  VIEWER
}

enum AvailabilityState {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
  FORBIDDEN
}
